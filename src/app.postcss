/* Write your global styles here, in PostCSS syntax */
@tailwind base;
@tailwind components;
@tailwind utilities;

@layer utilities {
	/* Hide scrollbar for Chrome, Safari and Opera */
	.no-scrollbar::-webkit-scrollbar {
		display: none;
	}
	/* Hide scrollbar for IE, Edge and Firefox */
	.no-scrollbar {
		-ms-overflow-style: none; /* IE and Edge */
		scrollbar-width: none; /* Firefox */
	}
}

body {
	@apply text-gray-800 w-screen;
	min-height: 100vh;
	min-height: -webkit-fill-available;
}

html {
	height: -webkit-fill-available;
}

:not(pre) > code {
	@apply font-mono text-sm bg-gray-500/30 rounded-md p-1;
}

pre {
	@apply font-mono text-sm bg-gray-500/30 rounded-md p-4 overflow-x-auto mb-2;
}

/* Obsidian-style callouts from @r4ai/remark-callout */
[data-callout] {
	@apply flex flex-col space-y-1 bg-gray-500/30 rounded-md p-4 mb-2;
}

[data-callout-title] {
	@apply font-bold;
}

figcaption {
	@apply text-sm text-gray-600 px-4 mb-4;
}

p {
	@apply mb-2;
}

figure,
figcaption {
	@apply mb-2;
}

h1,
h2,
h3,
h4,
h5,
h6 {
	@apply text-white/80 mb-4 drop-shadow-md;
}
h1 {
	@apply text-4xl;
}
h2 {
	@apply text-2xl;
}
h3 {
	@apply text-xl;
}
h4 {
	@apply text-lg;
}

a {
	@apply text-white/80 hover:underline drop-shadow-md;
}

ul {
	@apply list-disc list-outside pl-6 mb-2;
}

ol {
	@apply list-decimal list-outside pl-6 mb-2;
}
